# WQ Agent configuration.
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env

# --- required ---------------------------------------------------------------
# API key for the OpenAI-compatible endpoint.
API_KEY=sk-your-api-key-here

# Chat model name.
MODEL=deepseek-flash

# Base URL of the OpenAI-compatible endpoint (leave empty for api.openai.com).
BASE_URL=https://api.deepseek.com

# --- optional ---------------------------------------------------------------
# OPENAI_* names are accepted as fallbacks when the names above are absent:
# OPENAI_API_KEY=...
# OPENAI_MODEL=...
# OPENAI_BASE_URL=...

# Web search (searchAgent / WebSearchTool). Get a key at https://tavily.com,
# or leave it empty to disable web search - the tool then answers
# {"ok": false, "error": "missing TAVILY_API_KEY"} instead of crashing.
TAVILY_API_KEY=tvly-xxxxxxxx

# Defaults for the `wq` CLI (command line flags always win).
# WQ_WORKSPACE=workspace
# WQ_MODEL=gpt-4o-mini
# WQ_BASE_URL=http://localhost:8000/v1
# WQ_API_KEY=not-needed

# Examples for local / self-hosted OpenAI-compatible servers:
#   Ollama:  BASE_URL=http://localhost:11434/v1   MODEL=qwen2.5-coder:7b
#   vLLM:    BASE_URL=http://localhost:8000/v1    MODEL=Qwen/Qwen2.5-7B-Instruct
