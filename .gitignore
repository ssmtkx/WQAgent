# secrets
.env

# python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# local scratch (pip temp/downloads)
.tmp/

# tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# tiktoken's downloaded BPE vocabularies (e.g. cl100k_base, ~1.7 MB); langchain's
# token counting fetches them, and they land here when tiktoken's cache dir
# resolves to the relative path "data-gym-cache"
data-gym-cache/

# agent scratch space (default workspace)
workspace/

# checkpoints an agent run writes into its workspace
.wqagent/

# stray runtime logs (written into the cwd by other processes, e.g. IME debug output)
debug.log

# editors / os
.idea/
.vscode/
.DS_Store
Thumbs.db
